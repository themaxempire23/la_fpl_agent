{
  "name": "FPL Team Sync & Analysis",
  "nodes": [
    {
      "parameters": {
        "triggerType": "interval",
        "unit": "hours",
        "value": 6
      },
      "id": "Schedule Trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.trigger",
      "typeVersion": 1,
      "position": [
        50,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://fantasy.premierleague.com/api/bootstrap-static/",
        "authentication": "none",
        "responseFormat": "json"
      },
      "id": "Fetch FPL Bootstrap",
      "name": "Fetch FPL Bootstrap",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        250,
        100
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://fantasy.premierleague.com/api/entry/{{ $env.FPL_TEAM_ID }}/",
        "authentication": "none",
        "responseFormat": "json"
      },
      "id": "Fetch Team Entry",
      "name": "Fetch Team Entry",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        250,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "https://fantasy.premierleague.com/api/entry/{{ $env.FPL_TEAM_ID }}/event/{{ $nodeData['Get Current GW'].output.json.events[0].id }}/picks/",
        "authentication": "none",
        "responseFormat": "json"
      },
      "id": "Fetch Team Picks",
      "name": "Fetch Team Picks",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        250,
        500
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO fpl_bootstrap (gw, data, updated_at) VALUES ({{ $nodeData['Get Current GW'].output.json.events[0].id }}, $1, NOW()) ON CONFLICT (gw) DO UPDATE SET data = $1, updated_at = NOW();",
        "queryParams": [
          "{{ JSON.stringify($nodeData['Fetch FPL Bootstrap'].json) }}"
        ]
      },
      "id": "Store Bootstrap Data",
      "name": "Store Bootstrap Data",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        500,
        100
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO fpl_teams (team_id, data, updated_at) VALUES ({{ $nodeData['Fetch Team Entry'].json.id }}, $1, NOW()) ON CONFLICT (team_id) DO UPDATE SET data = $1, updated_at = NOW();",
        "queryParams": [
          "{{ JSON.stringify($nodeData['Fetch Team Entry'].json) }}"
        ]
      },
      "id": "Store Team Entry",
      "name": "Store Team Entry",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO fpl_picks (team_id, gw, data, updated_at) VALUES ({{ $nodeData['Fetch Team Entry'].json.id }}, {{ $nodeData['Get Current GW'].output.json.events[0].id }}, $1, NOW()) ON CONFLICT (team_id, gw) DO UPDATE SET data = $1, updated_at = NOW();",
        "queryParams": [
          "{{ JSON.stringify($nodeData['Fetch Team Picks'].json) }}"
        ]
      },
      "id": "Store Team Picks",
      "name": "Store Team Picks",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        500,
        500
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:11434/api/generate",
        "authentication": "none",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "model",
              "value": "llama2"
            },
            {
              "name": "prompt",
              "value": "Analyze FPL player form. Players: {{ $nodeData['Fetch FPL Bootstrap'].json.elements.slice(0,10).map(p => p.web_name + ' (Form: ' + p.form + ')').join(', ') }}. Give 3 transfer suggestions in JSON format: [{\"name\": \"...\", \"reason\": \"...\"}]"
            }
          ]
        }
      },
      "id": "Ollama Form Analysis",
      "name": "Ollama Form Analysis",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [
        750,
        200
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO fpl_suggestions (team_id, gw, suggestions, created_at) VALUES ({{ $nodeData['Fetch Team Entry'].json.id }}, {{ $nodeData['Get Current GW'].output.json.events[0].id }}, $1, NOW());",
        "queryParams": [
          "{{ $nodeData['Ollama Form Analysis'].json.response }}"
        ]
      },
      "id": "Store Suggestions",
      "name": "Store Suggestions",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        950,
        200
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "/fpl/team",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "Webhook Team Data",
      "name": "Webhook Team Data",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        50,
        600
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT data FROM fpl_teams WHERE team_id = $1 LIMIT 1;",
        "queryParams": [
          "{{ $url.searchParams.get('teamId') || $env.FPL_TEAM_ID }}"
        ]
      },
      "id": "Query Team from DB",
      "name": "Query Team from DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        250,
        600
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT data FROM fpl_picks WHERE team_id = $1 ORDER BY gw DESC LIMIT 1;",
        "queryParams": [
          "{{ $url.searchParams.get('teamId') || $env.FPL_TEAM_ID }}"
        ]
      },
      "id": "Query Picks from DB",
      "name": "Query Picks from DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        250,
        700
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT data FROM fpl_bootstrap ORDER BY updated_at DESC LIMIT 1;",
        "queryParams": []
      },
      "id": "Query Bootstrap from DB",
      "name": "Query Bootstrap from DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        250,
        800
      ]
    },
    {
      "parameters": {
        "responseData": "{{ { team: $nodeData['Query Team from DB'].output[0].data, picks: $nodeData['Query Picks from DB'].output[0].data, bootstrap: $nodeData['Query Bootstrap from DB'].output[0].data } }}"
      },
      "id": "Return Team Data",
      "name": "Return Team Data",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        500,
        700
      ]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "/fpl/suggestions",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "Webhook Suggestions",
      "name": "Webhook Suggestions",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        50,
        900
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT suggestions FROM fpl_suggestions WHERE team_id = $1 ORDER BY created_at DESC LIMIT 5;",
        "queryParams": [
          "{{ $url.searchParams.get('teamId') || $env.FPL_TEAM_ID }}"
        ]
      },
      "id": "Query Suggestions from DB",
      "name": "Query Suggestions from DB",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.3,
      "position": [
        250,
        900
      ]
    },
    {
      "parameters": {
        "responseData": "{{ { suggestions: $nodeData['Query Suggestions from DB'].output } }}"
      },
      "id": "Return Suggestions",
      "name": "Return Suggestions",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        500,
        900
      ]
    }
  ],
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Fetch FPL Bootstrap",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Team Entry",
            "type": "main",
            "index": 0
          },
          {
            "node": "Fetch Team Picks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch FPL Bootstrap": {
      "main": [
        [
          {
            "node": "Store Bootstrap Data",
            "type": "main",
            "index": 0
          },
          {
            "node": "Ollama Form Analysis",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Team Entry": {
      "main": [
        [
          {
            "node": "Store Team Entry",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Team Picks": {
      "main": [
        [
          {
            "node": "Store Team Picks",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Ollama Form Analysis": {
      "main": [
        [
          {
            "node": "Store Suggestions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Team Data": {
      "main": [
        [
          {
            "node": "Query Team from DB",
            "type": "main",
            "index": 0
          },
          {
            "node": "Query Picks from DB",
            "type": "main",
            "index": 0
          },
          {
            "node": "Query Bootstrap from DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Team from DB": {
      "main": [
        [
          {
            "node": "Return Team Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Picks from DB": {
      "main": [
        [
          {
            "node": "Return Team Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Bootstrap from DB": {
      "main": [
        [
          {
            "node": "Return Team Data",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Webhook Suggestions": {
      "main": [
        [
          {
            "node": "Query Suggestions from DB",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Query Suggestions from DB": {
      "main": [
        [
          {
            "node": "Return Suggestions",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
